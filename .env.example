# ==========================================
# CONFIGURACIÓN SAP GUI
# ==========================================
SAP_CONNECTION=SAP EWM S/4 (PRE-PRODUCTIVO)
SAPLOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
SAP_CLIENT=100
SAP_LANGUAGE=ES

SAP_USER=TU_USUARIO_SAP
SAP_PASS=TU_PASSWORD_SAP

SAP_TIMEOUT=30
SAP_STARTUP_WAIT=5
SAP_CLOSE_ON_FINISH=true

# ==========================================
# REPORTES Y NEXUS
# ==========================================
REPORT_TITLE=Reporte de Automatización SAP - Liverpool
APP_LABEL=SAP EWM S/4
NEXUS_PROJECT=SAP-EWM
NOTIFICATION_SUBTITLE=SAP EWM Procesos de Almacén

# Token de Nexus y Webhook de Google Chat
NEXUS_API_KEY=
AUTO_ACC=

# ==========================================
# JIRA CLOUD CONFIG
# ==========================================
JIRA_BASE_URL=https://tu-jira.atlassian.net
JIRA_USER_EMAIL=usuario@tuempresa.com
JIRA_API_TOKEN=tu_api_token_de_jira
